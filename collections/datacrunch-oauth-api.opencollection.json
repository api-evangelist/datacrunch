{
  "opencollection": "1.0.0",
  "info": {
    "name": "DataCrunch Public Balance OAuth API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "OAuth",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Obtain an OAuth2 access token",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.datacrunch.io/v1/oauth2/token",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Exchange a client_id and client_secret for a Bearer access token using the OAuth 2.0 Client Credentials grant. Tokens are scoped to cloud-api-v1 and restricted to documented Public API endpoints."
        }
      ]
    }
  ],
  "bundled": true
}